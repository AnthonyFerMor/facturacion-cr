# Variables de entorno de la app. En local, `npm run setup` escribe .env.local con
# los valores de la instancia local de Supabase. Este archivo no lleva valores.

# URL del proyecto de Supabase y su llave pública (publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional. Dirección de la API pública de Hacienda, para apuntar la app a un
# servidor de prueba. Sin esta variable se usa https://api.hacienda.go.cr.
# HACIENDA_API_URL=
